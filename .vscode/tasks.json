{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current C++ File",
            "type": "shell",
            "command": "clear && /usr/bin/g++ -std=c++20 -Wall -Wextra -pedantic -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}.out\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}